<?xml version="1.0" encoding="UTF-8"?>
<!--
  PDE demo: congruent melting compound.

  Energy form: HS
    G(x, T) = H(x) - T*S(x)

  System description:
    - One liquid phase spanning x in [0, 1].
    - Alpha: A-rich solid solution (x in [0, 0.35]).
    - AB compound: stoichiometric line phase at x = 0.5.
    - Beta: B-rich solid solution (x in [0.65, 1.0]).

  The AB compound melts congruently at a temperature
  higher than either pure component, producing a
  maximum in the liquidus curve.  Two eutectic valleys
  flank the compound peak.

  Melting points:
    A melts (liquid/alpha) at x = 0:
      T = (6.0 - 0.0) / (0.009 - 0.003) = 1000 K

    AB melts (liquid/compound) at x = 0.5:
      H_L(0.5) = 6.0 - 0.5 + 0.5 = 6.0
      T = (6.0 - (-3.0)) / (0.009 - 0.001) = 1125 K
      (Maximum: compound melts 125 K above endpoints.)

    B melts (liquid/beta) at x = 1:
      T = (7.0 - 1.0) / (0.009 - 0.003) = 1000 K
-->

<pde>

  <title>Congruent Melting Compound (AB at x=0.5)</title>

  <system>
    <components>A B</components>
    <energy_form>HS</energy_form>
    <units energy="kJ/mol" temperature="K"/>
  </system>

  <fields>
    <field name="temperature" symbol="T"
           unit="K" min="500" max="1200"
           initial="1200"/>
  </fields>

  <!-- ========================================================
       Liquid phase (full range)
       H_L(x) = 6.0 - 1.0x + 2.0x^2
         H_L(0) = 6.0   H_L(0.5) = 6.0   H_L(1) = 7.0
       S_L = 0.009
       ======================================================== -->

  <phase name="liquid" type="liquid">
    <energy model="quadratic">
      <H x0="6.0" x1="-1.0" x2="2.0"/>
      <S x0="0.009"/>
    </energy>
  </phase>

  <!-- ========================================================
       Alpha (A-rich solid, x in [0, 0.35])
       H_alpha(x) = 0.0 + 1.0x + 10.0x^2
       S_alpha = 0.003
       ======================================================== -->

  <phase name="alpha" type="solid">
    <composition_range xmin="0.0" xmax="0.35"/>
    <energy model="quadratic">
      <H x0="0.0" x1="1.0" x2="10.0"/>
      <S x0="0.003"/>
    </energy>
  </phase>

  <!-- ========================================================
       AB compound (stoichiometric, x = 0.5)
       H = -3.0   S = 0.001
       Deep enthalpy well creates the congruent maximum.
       ======================================================== -->

  <phase name="AB" type="end_member">
    <composition_range xmin="0.5" xmax="0.5"/>
    <energy model="point">
      <H>-3.0</H>
      <S>0.001</S>
    </energy>
  </phase>

  <!-- ========================================================
       Beta (B-rich solid, x in [0.65, 1.0])
       H_beta(x) = 10.5 - 19.0x + 9.5x^2
         H_beta(1) = 1.0
       S_beta = 0.003
       ======================================================== -->

  <phase name="beta" type="solid">
    <composition_range xmin="0.65" xmax="1.0"/>
    <energy model="quadratic">
      <H x0="10.5" x1="-19.0" x2="9.5"/>
      <S x0="0.003"/>
    </energy>
  </phase>

</pde>
