$ =============================================================
$ Cu-Ni simplified demo database for PDE
$
$ Isomorphous system: complete FCC solid solution.
$ Both elements are FCC; a simple lens diagram.
$
$ NOT for research.  Simplified linear G(T).
$ Units: SI (J/mol, K, Pa)
$ =============================================================

ELEMENT /-   ELECTRON_GAS   0.0      0.0      0.0 !
ELEMENT VA   VACUUM         0.0      0.0      0.0 !
ELEMENT CU   FCC_A1        63.546  5004.0    33.15 !
ELEMENT NI   FCC_A1        58.693  4787.0    29.87 !

TYPE_DEFINITION % SEQ *!
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !

PHASE LIQUID %  1  1.0 !
CONSTITUENT LIQUID : CU,NI : !

PARAMETER G(LIQUID,CU;0)  298.15  +12964-9.551*T;  3000 N !
PARAMETER G(LIQUID,NI;0)  298.15  +17615-10.195*T;  3000 N !
PARAMETER L(LIQUID,CU,NI;0)  298.15  -8000;  3000 N !

PHASE FCC_A1 %  2  1.0  1.0 !
CONSTITUENT FCC_A1 : CU,NI : VA : !

PARAMETER G(FCC_A1,CU:VA;0)  298.15  0;  3000 N !
PARAMETER G(FCC_A1,NI:VA;0)  298.15  0;  3000 N !
PARAMETER L(FCC_A1,CU,NI:VA;0)  298.15  -8500;  3000 N !

$ =============================================================
