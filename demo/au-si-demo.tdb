$ =============================================================
$ Au-Si simplified demo database for PDE
$
$ Deep eutectic system.  Au (FCC) melts at 1337 K,
$ Si (diamond) melts at 1687 K, but the eutectic
$ is dramatically lower (~700 K) due to strong
$ liquid stabilisation and mutual solid
$ insolubility.  Used in semiconductor processing
$ (Au wire bonding, eutectic die attach).
$
$ NOT for research.  Simplified linear G(T).
$ Units: SI (J/mol, K, Pa)
$ =============================================================

ELEMENT /-   ELECTRON_GAS   0.0      0.0      0.0 !
ELEMENT VA   VACUUM         0.0      0.0      0.0 !
ELEMENT AU   FCC_A1       196.967  6012.0    47.49 !
ELEMENT SI   DIAMOND_A4    28.086  3217.0    18.81 !

TYPE_DEFINITION % SEQ *!
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !

PHASE LIQUID %  1  1.0 !
CONSTITUENT LIQUID : AU,SI : !

$ Delta-G of fusion relative to SER.
$   Au melts: 12552 / 9.393 = 1336 K
$   Si melts: 50208 / 29.77 = 1687 K
PARAMETER G(LIQUID,AU;0)  298.15  +12552-9.393*T;  3000 N !
PARAMETER G(LIQUID,SI;0)  298.15  +50208-29.77*T;  3000 N !

$ Strong attraction in liquid drives the deep eutectic.
PARAMETER L(LIQUID,AU,SI;0)  298.15  -40000+5*T;  3000 N !
PARAMETER L(LIQUID,AU,SI;1)  298.15  -12000;  3000 N !

$ FCC_A1 — Au-rich; Si essentially insoluble
PHASE FCC_A1 %  2  1.0  1.0 !
CONSTITUENT FCC_A1 : AU,SI : VA : !

PARAMETER G(FCC_A1,AU:VA;0)  298.15  0;  3000 N !
PARAMETER G(FCC_A1,SI:VA;0)  298.15  +51000;  3000 N !
PARAMETER L(FCC_A1,AU,SI:VA;0)  298.15  +20000;  3000 N !

$ DIAMOND_A4 — Si-rich; Au essentially insoluble
PHASE DIAMOND_A4 %  2  1.0  1.0 !
CONSTITUENT DIAMOND_A4 : AU,SI : VA : !

PARAMETER G(DIAMOND_A4,AU:VA;0)  298.15  +50000;  3000 N !
PARAMETER G(DIAMOND_A4,SI:VA;0)  298.15  0;  3000 N !
PARAMETER L(DIAMOND_A4,AU,SI:VA;0)  298.15  +30000;  3000 N !

$ =============================================================
