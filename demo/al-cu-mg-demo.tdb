$ =============================================================
$ Al-Cu-Mg simplified ternary demo database for PDE
$
$ NOT for research use.  Simplified linear G(T) expressions
$ with basic Redlich-Kister binary interaction parameters.
$ Produces a qualitatively recognisable ternary eutectic
$ topology.
$
$ Units: SI (J/mol, K, Pa)
$ =============================================================

ELEMENT /-   ELECTRON_GAS   0.0      0.0      0.0 !
ELEMENT VA   VACUUM         0.0      0.0      0.0 !
ELEMENT AL   FCC_A1        26.982  4540.0    28.30 !
ELEMENT CU   FCC_A1        63.546  5004.0    33.15 !
ELEMENT MG   HCP_A3        24.305  4998.0    32.67 !

TYPE_DEFINITION % SEQ *!
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !

$ =============================================================
$ LIQUID — single sublattice (AL, CU, MG)
$ =============================================================

PHASE LIQUID %  1  1.0 !
CONSTITUENT LIQUID : AL,CU,MG : !

$ Delta-G of fusion relative to SER
$   AL melts ~933 K, CU melts ~1358 K, MG melts ~923 K
PARAMETER G(LIQUID,AL;0) 298.15  +10711-11.473*T;  3000 N !
PARAMETER G(LIQUID,CU;0) 298.15  +12964-9.551*T;   3000 N !
PARAMETER G(LIQUID,MG;0) 298.15  +8477-9.185*T;    3000 N !

$ Binary interactions in the liquid
PARAMETER L(LIQUID,AL,CU;0)  298.15  -67094+8.555*T;  3000 N !
PARAMETER L(LIQUID,AL,CU;1)  298.15  +32148-7.118*T;  3000 N !
PARAMETER L(LIQUID,AL,MG;0)  298.15  -12000+3.0*T;    3000 N !
PARAMETER L(LIQUID,AL,MG;1)  298.15  -1100+0.5*T;     3000 N !
PARAMETER L(LIQUID,CU,MG;0)  298.15  -23164+4.5*T;    3000 N !

$ =============================================================
$ FCC_A1 — two sublattices (AL, CU, MG)(VA)
$ =============================================================

PHASE FCC_A1 %  2  1.0  1.0 !
CONSTITUENT FCC_A1 : AL,CU,MG : VA : !

$ Pure-element G in FCC (SER for AL and CU)
PARAMETER G(FCC_A1,AL:VA;0)  298.15  0;        3000 N !
PARAMETER G(FCC_A1,CU:VA;0)  298.15  0;        3000 N !
PARAMETER G(FCC_A1,MG:VA;0)  298.15  +2600;    3000 N !

$ Binary interactions in FCC
PARAMETER L(FCC_A1,AL,CU:VA;0)  298.15  -53520+2.0*T;  3000 N !
PARAMETER L(FCC_A1,AL,CU:VA;1)  298.15  +38590-2.0*T;  3000 N !
PARAMETER L(FCC_A1,AL,MG:VA;0)  298.15  -1800+2.0*T;   3000 N !
PARAMETER L(FCC_A1,CU,MG:VA;0)  298.15  -5000+1.0*T;   3000 N !

$ =============================================================
$ HCP_A3 — two sublattices (AL, CU, MG)(VA)
$ =============================================================

PHASE HCP_A3 %  2  1.0  0.5 !
CONSTITUENT HCP_A3 : AL,CU,MG : VA : !

$ Pure-element G in HCP (SER for MG)
PARAMETER G(HCP_A3,AL:VA;0)  298.15  +5481-1.8*T;  3000 N !
PARAMETER G(HCP_A3,CU:VA;0)  298.15  +6000-1.0*T;  3000 N !
PARAMETER G(HCP_A3,MG:VA;0)  298.15  0;             3000 N !

$ Binary interactions in HCP
PARAMETER L(HCP_A3,AL,MG:VA;0)  298.15  +1950-2.0*T;  3000 N !
PARAMETER L(HCP_A3,CU,MG:VA;0)  298.15  -3000+1.0*T;  3000 N !

$ =============================================================
