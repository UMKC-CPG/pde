$ =============================================================
$ Cu-Pb simplified demo database for PDE
$
$ Liquid miscibility gap system.  Cu (FCC) and Pb
$ (FCC) have strongly positive mixing in the liquid,
$ producing a wide miscibility gap that persists to
$ high temperature.  The monotectic reaction is
$ L1 = FCC(Cu) + L2 on cooling.
$
$ Cu melts at ~1358 K, Pb melts at ~601 K.
$
$ NOT for research.  Simplified linear G(T).
$ Units: SI (J/mol, K, Pa)
$ =============================================================

ELEMENT /-   ELECTRON_GAS   0.0      0.0      0.0 !
ELEMENT VA   VACUUM         0.0      0.0      0.0 !
ELEMENT CU   FCC_A1        63.546  5004.0    33.15 !
ELEMENT PB   FCC_A1       207.200  6870.0    64.80 !

TYPE_DEFINITION % SEQ *!
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !

PHASE LIQUID %  1  1.0 !
CONSTITUENT LIQUID : CU,PB : !

$ Cu melts: 12964 / 9.551 = 1357 K
$ Pb melts:  4774 / 7.94  = 601 K
PARAMETER G(LIQUID,CU;0)  298.15  +12964-9.551*T;  3000 N !
PARAMETER G(LIQUID,PB;0)  298.15  +4774-7.94*T;    3000 N !

$ Strongly positive mixing in liquid => miscibility gap.
$ Gap closes (roughly) when L/(2RT) ~ 1 => T ~ L/(2R).
$ L = 60000 - 10T => at T=1200: L=48000, 48000/(2*8.314*1200) ~ 2.4
$ Still repulsive at 1200 K; gap narrows toward ~1500 K.
PARAMETER L(LIQUID,CU,PB;0)  298.15  +60000-10.0*T;  3000 N !
PARAMETER L(LIQUID,CU,PB;1)  298.15  +10000;  3000 N !

$ FCC_A1 — Cu-rich terminal; Pb barely soluble.
PHASE FCC_A1 %  2  1.0  1.0 !
CONSTITUENT FCC_A1 : CU,PB : VA : !

PARAMETER G(FCC_A1,CU:VA;0)  298.15  0;      3000 N !
PARAMETER G(FCC_A1,PB:VA;0)  298.15  +5000;  3000 N !
PARAMETER L(FCC_A1,CU,PB:VA;0)  298.15  +40000;  3000 N !

$ =============================================================
