<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sample input for PDE — asymmetric vapor-liquid equilibrium (VLE) binary A-B.

  Energy form: HS
    G(x, T) = H(x) - T·S(x)
    Coefficients in ascending composition order:
      x0 = constant term, x1 = linear in x.

  System description:
    - Two components: A (x=0) and B (x=1)
    - One gas phase, stable at high temperature
    - One liquid phase, stable at low temperature

  Pure-component boiling points (where G_gas = G_liquid):
    Component A:  T_boil = (H_g0 - H_l0) / (S_g - S_l)
                         = (14 - 2) / (0.03 - 0.01) = 600 K
    Component B:  T_boil = (H_g0+H_g1 - H_l0-H_l1) / (S_g - S_l)
                         = (20 - 4) / 0.02 = 800 K

  The resulting phase diagram shows a classic VLE lens:
    - Above the dew-point curve  → single-phase gas
    - Below the bubble-point curve → single-phase liquid
    - Between the two curves     → two-phase (gas + liquid) region
-->

<pde>

  <system>
    <components>A B</components>
    <energy_form>HS</energy_form>
  </system>

  <temperature>
    <min>100</min>
    <max>1500</max>
    <initial>1500</initial>
  </temperature>

  <!-- ============================================================
       Gas phase (stable at high T)
       H_g(x) = 14 + 6x       (high reference energy, linear in x)
       S_g(x) = 0.03           (high entropy → strongly stabilized by T)

       At T=1000 K: G_g ≈ 14 + 6x - 30 = -16 + 6x
       At T= 400 K: G_g ≈ 14 + 6x - 12 =   2 + 6x
       ============================================================ -->

  <phase name="gas" type="gas">
    <energy model="quadratic">
      <H x0="14.0" x1="-6.0" x2="8.0"/>
      <S x0="0.03"/>
    </energy>
  </phase>

  <!-- ============================================================
       Liquid phase (stable at low T)
       H_l(x) = 2 + 2x        (lower reference energy, linear in x)
       S_l(x) = 0.01           (lower entropy)

       At T=1000 K: G_l ≈ 2 + 2x - 10 =  -8 + 2x  (above gas)
       At T= 400 K: G_l ≈ 2 + 2x -  4 =  -2 + 2x  (below gas)
       ============================================================ -->

  <phase name="liquid" type="liquid">
    <energy model="quadratic">
      <H x0="2.0" x1="-2.0" x2="4.0"/>
      <S x0="0.01"/>
    </energy>
  </phase>

</pde>
