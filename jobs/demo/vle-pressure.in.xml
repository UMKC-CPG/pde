<?xml version="1.0" encoding="UTF-8"?>
<!--
  vle-pressure.in.xml  -  Vapor-liquid equilibrium, binary A-B, variable pressure.

  Energy units: kJ/mol.  Temperature: K.  Pressure: atm.
  R_gas = 8.314e-3 kJ/mol/K.

  Both phases are given as explicit HS polynomials (ascending x-order).
  Neither phase is concave at any composition or temperature because the
  second derivatives are constant and positive:

    G_liq''(x) = 2 * H_liq_x2                    = 2 * 2.0  =  4.0  kJ/mol
    G_gas''(x) = 2 * H_gas_x2 - T * 2 * S_gas_x2 = 2 * 1.0  =  2.0  kJ/mol
                 (S_gas has no x^2 term, so T drops out of the curvature)

  Pure-component boiling points at P = P_ref = 1 atm are exact by construction.
  At P_ref the ideal-gas term R*T*ln(P/P_ref) vanishes, so the conditions reduce
  to G_gas(x_i, T_bp) = G_liq(x_i, T_bp):

    x = 0  (pure A):  h0_gas - T_A * s0_gas  =  - T_A * s0_liq
                      14.4   - 360  * 0.12   =  -360  * 0.08   = -28.8  kJ/mol  ✓

    x = 1  (pure B):  (h0+h1+h2)_gas - T_B * (s0+s1)_gas  =  h2_liq - T_B * s0_liq
                      23.5            - 430  * 0.13         =  2.0    - 430  * 0.08
                      23.5 - 55.9 = -32.4                  =  2.0 - 34.4  = -32.4  ✓

  Pressure dependence:
    Vapor: R*T*ln(P/P_ref) added via ideal_gas="true".  Raising P increases
           G_gas, suppressing the vapor phase and raising both boiling points.
    Liquid: no Poynting correction (V block omitted); liquid G is pressure-
            independent, which is the dominant physical regime for condensed
            phases at moderate pressures.

  Parameters
  Liquid:
    H(x) = 2.0 * x^2               kJ/mol  (small positive mixing enthalpy)
    S(x) = 0.08                     kJ/mol/K

  Vapor (ideal gas):
    H(x) = 14.4 + 8.1*x + 1.0*x^2  kJ/mol
    S(x) = 0.12 + 0.01*x            kJ/mol/K

  Expected behaviour:
    T = 300 K  — single-phase liquid across all x.
    T = 360 K  — vapor and liquid coexist at x = 0 (pure A boiling point, 1 atm).
    T = 430 K  — vapor and liquid coexist at x = 1 (pure B boiling point, 1 atm).
    T = 500 K  — single-phase vapor across all x.
    Increasing P raises G_vapor, shifting the VLE lens to higher temperatures.
    Decreasing P lowers G_vapor, shifting the lens to lower temperatures.
-->

<pde>

  <title>Vapor-Liquid Equilibrium (A-B, variable P)</title>

  <system>
    <components>A B</components>
    <energy_form>HS</energy_form>
  </system>

  <fields>
    <field name="temperature" symbol="T" unit="K"
           min="300" max="500" initial="395"/>
    <field name="pressure" symbol="P" unit="atm"
           min="0.5" max="5.0" initial="1.0"
           R_gas="8.314e-3" P_ref="1.0"/>
  </fields>

  <phase name="vapor" type="gas" ideal_gas="true">
    <energy model="quadratic">
      <H x0="14.4" x1="8.1" x2="1.0"/>
      <S x0="0.12"  x1="0.01"/>
    </energy>
  </phase>

  <phase name="liquid" type="liquid">
    <energy model="quadratic">
      <H x0="0.0" x1="0.0" x2="2.0"/>
      <S x0="0.08"/>
    </energy>
  </phase>

</pde>
