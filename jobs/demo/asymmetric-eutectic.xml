<?xml version="1.0" encoding="UTF-8"?>
<!--
  PDE demo — asymmetric eutectic binary A-B.

  Energy form: HS
    G(x, T) = H(x) - T·S(x)

  System description:
    - Component A melts at a much higher temperature than component B.
    - One liquid phase spanning the full composition range.
    - Alpha: A-rich solid solution (x ∈ [0, 0.45]).
    - Beta:  B-rich solid solution (x ∈ [0.55, 1.0]).
    - The eutectic point is shifted toward the low-melting B side.

  Pure-component melting points (where G_liquid = G_solid at x=0 or x=1):

    Component A:  T_melt = (H_L0 - H_α0) / (S_L - S_α)
                         = (8.9 - 0.5) / (0.01 - 0.004) = 8.4 / 0.006 = 1400 K

    Component B:  T_melt = (H_L1 - H_β1) / (S_L - S_β)
                         = (5.9 - 0.5) / (0.01 - 0.004) = 5.4 / 0.006 =  900 K

  The eutectic falls somewhere below 900 K, shifted toward x = 1.
-->

<pde>

  <system>
    <components>A B</components>
    <energy_form>HS</energy_form>
  </system>

  <temperature>
    <min>300</min>
    <max>1500</max>
    <initial>1500</initial>
  </temperature>

  <!-- ============================================================
       Liquid phase
       H_L(x) = 8.9 - 6.0x + 3.0x²
         H_L(0) = 8.9   H_L(1) = 5.9   (low-melting B end)
       S_L = 0.01 (flat, high entropy → stable at high T)
       ============================================================ -->

  <phase name="liquid" type="liquid">
    <energy model="quadratic">
      <H x0="8.9" x1="-6.0" x2="3.0"/>
      <S x0="0.01"/>
    </energy>
  </phase>

  <!-- ============================================================
       Alpha phase (A-rich solid solution, x ∈ [0.0, 0.45])
       H_α(x) = 0.5 - 1.0x + 5.0x²
         H_α(0) = 0.5   (deep A well, rises steeply toward B)
       S_α = 0.004
       ============================================================ -->

  <phase name="alpha" type="solid">
    <composition_range xmin="0.0" xmax="0.45"/>
    <energy model="quadratic">
      <H x0="0.5" x1="-1.0" x2="5.0"/>
      <S x0="0.004"/>
    </energy>
  </phase>

  <!-- ============================================================
       Beta phase (B-rich solid solution, x ∈ [0.55, 1.0])
       H_β(x) = 5.0x² - 9.5x + 5.0
         H_β(1) = 0.5   (mirror well on the B side)
       S_β = 0.004
       ============================================================ -->

  <phase name="beta" type="solid">
    <composition_range xmin="0.55" xmax="1.0"/>
    <energy model="quadratic">
      <H x0="5.0" x1="-9.5" x2="5.0"/>
      <S x0="0.004"/>
    </energy>
  </phase>

</pde>
