<?xml version="1.0" encoding="UTF-8"?>
<!--
  PDE demo — eutectoid binary A-B (all-solid, no liquid in temperature range).

  Energy form: HS
    G(x, T) = H(x) - T·S(x)

  System description:
    - No liquid phase is present in the displayed temperature range (300–1000 K).
    - Gamma: high-temperature solid phase, full composition range (e.g. FCC).
    - Alpha: low-temperature A-rich phase (x ∈ [0, 0.35], e.g. BCC).
    - Beta:  low-temperature B-rich phase (x ∈ [0.65, 1.0]).

  Solid-state transition temperatures at the pure endpoints:

    Gamma → Alpha at x = 0:
      T_trans = (H_γ0 - H_α0) / (S_γ - S_α)
              = (3.2 - 0.0) / (0.006 - 0.002) = 3.2 / 0.004 = 800 K

    Gamma → Beta at x = 1:
      T_trans = (H_γ1 - H_β1) / (S_γ - S_β)
              = (2.8 - 0.0) / (0.006 - 0.002) = 2.8 / 0.004 = 700 K

  The eutectoid reaction (gamma → alpha + beta) occurs at a temperature
  between 700 K and 800 K depending on the equilibrium composition of gamma.
  Below the eutectoid temperature the alpha + beta two-phase field opens up.
-->

<pde>

  <system>
    <components>A B</components>
    <energy_form>HS</energy_form>
  </system>

  <temperature>
    <min>300</min>
    <max>1000</max>
    <initial>1000</initial>
  </temperature>

  <!-- ============================================================
       Gamma phase (high-T solid, full range x ∈ [0, 1])
       H_γ(x) = 3.2 - 1.0x + 0.6x²
         H_γ(0) = 3.2   H_γ(1) = 2.8   (slightly asymmetric)
       S_γ = 0.006 (higher vibrational/configurational entropy than alpha/beta)
       ============================================================ -->

  <phase name="gamma" type="solid">
    <energy model="quadratic">
      <H x0="3.2" x1="-1.0" x2="0.6"/>
      <S x0="0.006"/>
    </energy>
  </phase>

  <!-- ============================================================
       Alpha phase (A-rich low-T solid, x ∈ [0.0, 0.35])
       H_α(x) = 0.0 - 0.5x + 3.0x²   (deep A well)
       S_α = 0.002 (ordered, low entropy)
       ============================================================ -->

  <phase name="alpha" type="solid">
    <composition_range xmin="0.0" xmax="0.35"/>
    <energy model="quadratic">
      <H x0="0.0" x1="-0.5" x2="3.0"/>
      <S x0="0.002"/>
    </energy>
  </phase>

  <!-- ============================================================
       Beta phase (B-rich low-T solid, x ∈ [0.65, 1.0])
       H_β(x) = 3.0x² - 5.0x + 2.0
         H_β(1) = 0.0   (mirror of alpha on the B side)
       S_β = 0.002
       ============================================================ -->

  <phase name="beta" type="solid">
    <composition_range xmin="0.65" xmax="1.0"/>
    <energy model="quadratic">
      <H x0="2.0" x1="-5.0" x2="3.0"/>
      <S x0="0.002"/>
    </energy>
  </phase>

</pde>
